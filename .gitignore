# --- R Specific ---
.Rhistory
.RData
.Ruserdata
.Rproj.user/
.Rapp.history
*-Ex.R
/*.tar.gz
/*.check/
.DS_Store
.Rprofile.bak
.Renviron.bak

# --- R Package specific ---
# Track NAMESPACE and man/ as they are part of the source
# !/NAMESPACE
# !/man/

# --- Statistics and Documentation ---
*.html
*.pdf
*.png
*.docx
*.pptx

# --- Quarto / RMarkdown ---
/.quarto/
*_files/
*_cache/
site_libs/

# --- Data Management (projthis workflow) ---
# Most local data and generated outputs are ignored; selected files are listed below.
/analyses/output/
/analyses/*.sqlite
/analyses/*.sqlite-journal

# --- renv ---
# Track renv.lock for reproducibility
# !renv.lock
# Ignore the actual library and local state
/renv/library/
/renv/local/
/renv/python/
/renv/staging/
/renv/cache/

# --- OS / IDE Specific ---
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp
*~

# --- Miscellaneous ---
*.log
.pdm-python
.python-version

# Track analysis .md reports and explicitly selected preview PNGs for GitHub.
# Other rendered assets and final TIFF panels remain ignored by the rules above.

# Selected reproducibility inputs, preview images and Table S3 source tables.
